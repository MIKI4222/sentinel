# Sentinel Environment Variables
# Copy this file to .env and fill in your values

# GenLayer Contract Configuration
VITE_GENLAYER_CONTRACT_ADDRESS=0xD934fA3E6EB893f56dd1d53DBeD9fd6f66678000
VITE_GENLAYER_NETWORK=bradbury

# Optional: Custom RPC (defaults to Bradbury public RPC)
# VITE_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com

# Optional: Custom Explorer (defaults to Bradbury explorer)
# VITE_GENLAYER_EXPLORER_URL=https://explorer-bradbury.genlayer.com